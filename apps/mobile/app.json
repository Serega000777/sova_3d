{
  "expo": {
    "name": "Sova 3D",
    "slug": "physical-ai-3d",
    "version": "0.1.0",
    "icon": "./assets/brand/app-icon.png",
    "scheme": "physicalai",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0c0e",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/brand/app-icon.png",
      "bundleIdentifier": "com.physicalai.three",
      "infoPlist": {
        "NSCameraUsageDescription": "Take reference photos and scan objects you want to model."
      }
    },
    "android": {
      "package": "com.physicalai.three",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "backgroundColor": "#0b0c0e"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-icon.png",
          "imageWidth": 256,
          "resizeMode": "contain",
          "backgroundColor": "#0b0c0e"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "http://localhost:18000",
      "webUrl": "http://localhost:3100",
      "router": {},
      "eas": {
        "projectId": "5a4b48cd-a2e9-41e5-8d33-091138bbd5ee"
      }
    },
    "owner": "savasava7777777"
  }
}

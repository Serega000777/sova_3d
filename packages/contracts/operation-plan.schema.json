{
  "$defs": {
    "AddHole": {
      "additionalProperties": false,
      "description": "Cylindrical hole drilled into `face` at `position_mm` (face-local XY), along -normal.",
      "properties": {
        "id": {
          "examples": [
            "box1",
            "hole_2"
          ],
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "type": {
          "const": "add_hole",
          "title": "Type",
          "type": "string"
        },
        "target": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Target",
          "type": "string"
        },
        "face": {
          "discriminator": {
            "mapping": {
              "all_faces": "#/$defs/AllFaces",
              "face_by_normal": "#/$defs/FaceByNormal"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/FaceByNormal"
            },
            {
              "$ref": "#/$defs/AllFaces"
            }
          ],
          "title": "Face"
        },
        "position_mm": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Position Mm",
          "type": "array"
        },
        "diameter_mm": {
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Diameter Mm",
          "type": "number"
        },
        "depth_mm": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 10000,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "omit for a through hole",
          "title": "Depth Mm"
        }
      },
      "required": [
        "id",
        "type",
        "target",
        "face",
        "position_mm",
        "diameter_mm"
      ],
      "title": "AddHole",
      "type": "object"
    },

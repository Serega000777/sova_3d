{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OperationPlan",
  "type": "object",
  "required": [
    "schema_version",
    "goal",
    "operations",
    "validation_steps"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "goal": {
      "type": "string"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_clarifications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "schema_version",
          "params"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "schema_version": {
            "type": "integer"
          },
          "params": {
            "type": "object"
          },
          "entity_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "validation_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
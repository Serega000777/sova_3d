{
  "expo": {
    "name": "Sova 3D",
    "slug": "physical-ai-3d",
    "version": "0.1.0",
    "scheme": "physicalai",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0c0e",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.physicalai.three",
      "infoPlist": {
        "NSCameraUsageDescription": "Take reference photos and scan objects you want to model."
      }
    },
    "android": {
      "package": "com.physicalai.three"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "http://localhost:18000",
      "router": {},
      "eas": {
        "projectId": "5a4b48cd-a2e9-41e5-8d33-091138bbd5ee"
      }
    },
    "owner": "savasava7777777"
  }
}

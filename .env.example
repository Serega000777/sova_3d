# Copy to .env for local development. Every variable without a default here is required;
# services/api/app/config.py rejects a missing or malformed value at startup.

APP_ENV=local
LOG_LEVEL=INFO

# Postgres (SQLAlchemy URL). Inside docker compose the host becomes `postgres`.
DATABASE_URL=postgresql+psycopg://physicalai:physicalai_dev@localhost:15432/physicalai
REDIS_URL=redis://localhost:16379/0

# S3-compatible object storage (MinIO locally). Bucket is created by infra/docker-compose.yml.
S3_ENDPOINT=http://localhost:19000
S3_BUCKET=physical-ai-dev
S3_ACCESS_KEY=physicalai
S3_SECRET_KEY=physicalai_dev_secret
S3_REGION=us-east-1

# AI planner: stub | anthropic. Real provider keys are added when T-041 lands.
AI_PROVIDER=stub
AI_BUDGET_USD_PER_JOB=1.00

# Host ports published by infra/docker-compose.yml (containers talk on the default ports).
POSTGRES_PORT=15432
REDIS_PORT=16379
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001
API_PORT=18000

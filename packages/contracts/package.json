{
  "name": "@physical-ai/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./operation-plan.schema.json": "./operation-plan.schema.json",
    "./openapi.json": "./openapi.json",
    "./integrity-report.schema.json": "./integrity-report.schema.json",
    "./print-analysis.schema.json": "./print-analysis.schema.json"
  },
  "files": [
    "dist",
    "operation-plan.schema.json",
    "integrity-report.schema.json",
    "print-analysis.schema.json",
    "openapi.yaml",
    "examples"
  ],
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/api.d.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').copyFileSync('src/api.d.ts','dist/api.d.ts')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.0"
  }
}
